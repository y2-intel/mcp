{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "y2-intel-mcp",
	"account_id": "27d1f608c06ff50311a707dd28f2daf8",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-05",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		"MCP_ORIGIN": "https://y2-intel-mcp.managed-services.workers.dev",
		"Y2_ORIGIN": "https://y2.dev",
		"API_ORIGIN": "https://api.y2.dev"
	},
	"kv_namespaces": [
		{ "binding": "OAUTH_KV", "id": "d38a579d892d4144a17a9819b35ebf61" }
	],
	"ratelimits": [
		{
			"name": "REQUEST_LIMITER",
			"namespace_id": "2026100501",
			"simple": { "limit": 120, "period": 60 }
		}
	],
	"assets": {
		"directory": "./dist-ui",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "invocation_logs": false }
	}
}
