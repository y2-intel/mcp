{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "y2-intel-mcp",
	"account_id": "7fd7cf7ff43f4e4b5adc63253ee0d858",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-05",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "mcp.y2.dev", "custom_domain": true }],
	"vars": {
		"MCP_ORIGIN": "https://mcp.y2.dev",
		"Y2_ORIGIN": "https://y2.dev",
		"API_ORIGIN": "https://api.y2.dev"
	},
	"kv_namespaces": [
		{ "binding": "OAUTH_KV", "id": "570a95efc65340c1839d99e3d5475e74" }
	],
	"ratelimits": [
		{
			"name": "REQUEST_LIMITER",
			"namespace_id": "2026100501",
			"simple": { "limit": 120, "period": 60 }
		}
	],
	"assets": {
		"directory": "./dist-ui",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "invocation_logs": false }
	}
}
