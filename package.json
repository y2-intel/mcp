{
	"name": "@y2-intel/mcp",
	"version": "0.4.0",
	"description": "MCP server for connecting AI agents to Y2",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Y2",
	"homepage": "https://y2.dev/docs/api/mcp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/y2-intel/mcp.git"
	},
	"bugs": {
		"url": "https://github.com/y2-intel/mcp/issues"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"claude",
		"codex",
		"ai-agents",
		"y2",
		"intelligence",
		"openapi"
	],
	"bin": {
		"y2-mcp": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"SECURITY.md",
		"CHANGELOG.md",
		"examples",
		"server.json"
	],
	"mcpName": "io.github.y2-intel/mcp",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check:openapi": "node --import tsx scripts/check-openapi.ts",
		"dev": "tsx src/index.ts",
		"inspect:all": "npm run inspect:tools && npm run inspect:resources && npm run inspect:prompts && npm run inspect:openapi && npm run inspect:no-key-error",
		"inspect:no-key-error": "node --import tsx scripts/check-no-key.ts",
		"inspect:openapi": "npx @modelcontextprotocol/inspector --cli node dist/index.js --method tools/call --tool-name y2_get_openapi_operation --tool-arg operationId=listReports",
		"inspect:prompts": "npx @modelcontextprotocol/inspector --cli node dist/index.js --method prompts/list",
		"inspect:resources": "npx @modelcontextprotocol/inspector --cli node dist/index.js --method resources/list",
		"inspect:tools": "npx @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list",
		"prepublishOnly": "npm run release:check",
		"release:check": "npm run build && npm run typecheck:extras && npm run build:native && npm test && npm run check:openapi && npm run check:plugins && npm pack --dry-run && npm run inspect:all",
		"smoke:live": "tsx scripts/smoke-live.ts",
		"test": "node --import tsx --test test/*.test.ts test/native/*.test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:extras",
		"typecheck:extras": "tsc -p tsconfig.tests.json",
		"build:ui": "vite build",
		"typecheck:native": "tsc -p tsconfig.worker.json && tsc -p tsconfig.ui.json",
		"build:native": "npm run typecheck:native && npm run build:ui",
		"deploy:native": "npm run build:native && wrangler deploy",
		"check:plugins": "node scripts/check-plugins.mjs",
		"pack:plugins": "node scripts/pack-plugins.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"yaml": "^2.9.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/workers-oauth-provider": "^1.2.4",
		"@cloudflare/workers-types": "^5.20261025.1",
		"@modelcontextprotocol/client": "^2.4.0",
		"@modelcontextprotocol/ext-apps": "^2.0.3",
		"@modelcontextprotocol/server": "^2.4.0",
		"@types/node": "^26.6.5",
		"ajv": "^8.20.0",
		"esbuild": "^0.28.2",
		"maplibre-gl": "^6.16.0",
		"miniflare": "^5.20261019.2-beta",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"wrangler": "^4.152.0"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	}
}
